#!/bin/sh
# Debian launcher for the desktop front-end: Qt when PySide6 is present in
# the private runtime, Tk otherwise (argus-gui --tk also forces Tk).
set -e
VENV=/var/lib/argus-scanner/runtime

if [ ! -x "$VENV/bin/argus-gui" ]; then
    echo "argus-gui: the Python runtime is not installed." >&2
    echo "argus-gui: run 'sudo argus-setup-runtime' (needs network or --wheelhouse DIR)." >&2
    exit 2
fi

PYTHONNOUSERSITE=1
export PYTHONNOUSERSITE
PATH="$VENV/bin:$PATH"
export PATH

exec "$VENV/bin/argus-gui" "$@"
