#!/bin/sh
# Debian launcher: run argus from the private runtime provisioned at install.
set -e
VENV=/var/lib/argus-scanner/runtime

if [ ! -x "$VENV/bin/argus" ]; then
    echo "argus: the Python runtime is not installed." >&2
    echo "argus: run 'sudo argus-setup-runtime' (needs network or --wheelhouse DIR)." >&2
    exit 2
fi

PYTHONNOUSERSITE=1
export PYTHONNOUSERSITE
PATH="$VENV/bin:$PATH"
export PATH

exec "$VENV/bin/argus" "$@"
